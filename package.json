{
  "name": "immistack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:claims && vite-react-ssg build && node scripts/verify-prerender.mjs && node scripts/check-placeholders.mjs",
    "build:spa": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "twenty:schema": "node scripts/twenty-schema.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:prerender": "node scripts/verify-prerender.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@upstash/redis": "1.38.4",
    "lucide-react": "^1.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-react-ssg": "^0.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
