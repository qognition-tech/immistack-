# ---------------------------------------------------------------------------
# Server-side only. Never prefix these with VITE_ — Vite exposes VITE_* to the
# browser bundle, and these are secrets.
# Copy to .env for local dev; set the same names in the Vercel project.
# ---------------------------------------------------------------------------

# Twenty CRM — where every form submission lands.
# Required to reach the CRM. Without it, a submission is still durably stored
# in Upstash Redis (see below) and a fallback email is attempted — the visitor
# still sees success, but nothing lands in Twenty until this is set.
TWENTY_API_KEY=

# Optional. Defaults to https://api.twenty.com (Twenty Cloud).
# Set this only if you self-host Twenty.
TWENTY_API_URL=https://api.twenty.com

# Cal.com booking webhook signing secret.
# Required for /api/cal-webhook. Without it the webhook refuses every request
# rather than accepting unsigned writes into a shared CRM.
CALCOM_WEBHOOK_SECRET=

# Public Cal.com booking link, e.g. "immistack/intro".
# This one IS client-side on purpose — it is a public booking URL, not a secret.
VITE_CALCOM_LINK=

# GTM container id (e.g. "GTM-XXXXXXX"). GA4/GTM event plan is
# lib/analytics.ts — every push no-ops when this is unset, so a preview build
# with no container configured never throws.
VITE_GTM_ID=

# ---------------------------------------------------------------------------
# Lead-capture hardening (2026-09) — brings this site's forms up to the
# ../govx-marketing pattern. See api/create-lead.ts, api/form-token.ts.
# ---------------------------------------------------------------------------

# HMAC secret for the min-time form token (api/_hmac.ts). Required for
# /api/form-token to issue a token — without it, that endpoint returns a
# clean 503 and /api/create-lead skips the min-time check entirely (the
# honeypot still applies). Any long random string; not shared with any other
# secret in this project.
LEAD_FORM_SECRET=

# Upstash Redis REST credentials — the durable lead store. Written to BEFORE
# every Twenty CRM call, so a Twenty outage or bad API key never loses a
# submission. Without both set, every lead write is a loud no-op (logged, not
# silent) and the only copy of a lead is Twenty (if configured) and/or the
# fallback email below.
# Note: Upstash, not Vercel KV — this is the operator's standing rule for
# Redis across this workspace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where the fallback email goes when the Twenty push fails, or Twenty is not
# configured at all. Without this (or without RESEND_API_KEY), the lead is
# still safe in the Upstash store — the fallback is logged as "needs manual
# follow-up" instead of emailed.
LEAD_FALLBACK_TO=
RESEND_API_KEY=

# Optional. Resend requires the sending domain to be verified on the account.
# Defaults to "ImmiStack leads <leads@immistack.com>" — override only if that
# domain is not the one verified in Resend.
LEAD_FALLBACK_FROM=

# ---------------------------------------------------------------------------
# DEAD — the Zoho integration was replaced by Twenty on 2026-08-26.
# These are listed only so anyone who finds them in the Vercel project knows
# they can be deleted. Nothing reads them.
#   ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET / ZOHO_REFRESH_TOKEN
# ---------------------------------------------------------------------------
