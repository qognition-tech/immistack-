# ---------------------------------------------------------------------------
# Server-side only. Never prefix these with VITE_ — Vite exposes VITE_* to the
# browser bundle, and these are secrets.
# Copy to .env for local dev; set the same names in the Vercel project.
# ---------------------------------------------------------------------------

# Twenty CRM — where every form submission lands.
# Required. Without it /api/create-lead returns a clean 503 rather than
# pretending the submission was saved.
TWENTY_API_KEY=

# Optional. Defaults to https://api.twenty.com (Twenty Cloud).
# Set this only if you self-host Twenty.
TWENTY_API_URL=https://api.twenty.com

# Cal.com booking webhook signing secret.
# Required for /api/cal-webhook. Without it the webhook refuses every request
# rather than accepting unsigned writes into a shared CRM.
CALCOM_WEBHOOK_SECRET=

# Public Cal.com booking link, e.g. "immistack/intro".
# This one IS client-side on purpose — it is a public booking URL, not a secret.
VITE_CALCOM_LINK=

# Resend — sends the lead confirmation + internal notification emails alongside
# the Twenty CRM write. Optional: without RESEND_API_KEY or RESEND_FROM,
# api/_email.ts returns {sent:false, reason:'unconfigured'}, logs ONE warning,
# and the CRM write and API response for the visitor are unaffected.
RESEND_API_KEY=

# Must be a sender on a domain verified in the Resend account, e.g.
# "ImmiStack <hello@immistack.com>".
RESEND_FROM=

# Where the internal "new lead" notification is sent. Defaults to
# hello@immistack.com if unset.
LEAD_NOTIFY_TO=

# ---------------------------------------------------------------------------
# DEAD — the Zoho integration was replaced by Twenty on 2026-08-26.
# These are listed only so anyone who finds them in the Vercel project knows
# they can be deleted. Nothing reads them.
#   ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET / ZOHO_REFRESH_TOKEN
# ---------------------------------------------------------------------------
